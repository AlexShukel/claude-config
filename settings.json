{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/daily-config-pull.sh",
            "async": true,
            "timeout": 60,
            "statusMessage": "Syncing Claude config..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/Git/halo/scripts/notify-telegram.sh\" ] && jq -r '\"⏳ Claude [\" + ((.cwd // \"?\") | split(\"/\") | last) + \"] \" + (.message // \"needs attention\")' | \"$HOME/Git/halo/scripts/notify-telegram.sh\" || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/Git/halo/scripts/notify-telegram.sh\" ] && jq -r '\"❌ Claude [\" + ((.cwd // \"?\") | split(\"/\") | last) + \"] turn failed: \" + (.error // .message // \"API error\")' | \"$HOME/Git/halo/scripts/notify-telegram.sh\" || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/Git/halo/scripts/notify-telegram.sh\" ] && jq -r '\"🏁 Claude [\" + ((.cwd // \"?\") | split(\"/\") | last) + \"] session ended\" + ((.reason // \"\") | if . == \"\" then \"\" else \" — \" + . end)' | \"$HOME/Git/halo/scripts/notify-telegram.sh\" || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
